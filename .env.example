# Copy to backend/.env (or project root .env — config loads either) and edit as needed.

# --- Database (existing docker instance) ---
DATABASE_URL=postgresql://postgres:2004@localhost:5432/interview

# --- LLM providers ---
# Conductor picks are per-purpose so you can mix e.g. free Groq for interviews, local for extraction.
# Valid values: gemini | groq | ollama. Models per provider are fixed sane defaults, see app/llm.
# 2026-10-27 benchmark (scripts/benchmark.py, benchmark_results/bench_20261027_17*.json):
# groq 2x faster and pushes vague answers for evidence (2/3 vs ollama 1/3) -> conductor/eval/report
# hosted. Extractor also groq (uploads should not sit 30s on the local model; one call per session,
# free tier absorbs it, and fallback heuristics cover outage). DSA generation stays local
# (generation-time validation + bank fallback make low hit-rate harmless, no quota burn).
LLM_CONDUCTOR_PROVIDER=groq
LLM_EVALUATOR_PROVIDER=groq
LLM_EXTRACTOR_PROVIDER=groq
LLM_GENERATOR_PROVIDER=ollama
LLM_REPORT_PROVIDER=groq

# --- API keys (optional; only needed for gemini/groq) ---
GOOGLE_API_KEY=
GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-120b   # Groq's free catalog rotates; overridden here to pin the current best

# --- Ollama (local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# --- Estimated cost per 1M tokens (for usage-cost reporting; informational only) ---
COST_PER_MTOK_INPUT_USD=0.0
COST_PER_MTOK_OUTPUT_USD=0.0

# --- Salary estimator constraint (see SPEC §6; raise if your intent differs) ---
SALARY_CAP_INR=200000

# --- Auth (required for login; use a long random string, e.g. from: python3 -c "import secrets; print(secrets.token_hex(32))") ---
AUTH_SECRET=

# --- Misc ---
STT_MODEL=base          # faster-whisper size: tiny|base|small

# Interviewer voice: local Coqui TTS microservice (scripts/tts.sh, backend/.venv-tts, :8001).
# Synthesis runs OUTSIDE the main venv (its own python 3.14 + CPU torch) — keep it that way.
TTS_SERVICE_URL=http://localhost:8001
TTS_INTERNAL_KEY=dev-insecure-tts-key
MAX_RESUME_MB=15
FRONTEND_ORIGIN=http://localhost:3000
